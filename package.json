{
  "name": "steam-playtime",
  "version": "1.0.0",
  "private": true,
  "description": "每日 Steam 游戏时长追踪，通过 GitHub Actions 定时快照 + 差分，发布到 GitHub Pages",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test scripts/diff.test.mjs",
    "fetch": "node scripts/fetch.mjs",
    "diff": "node scripts/diff.mjs",
    "build": "node scripts/build.mjs",
    "pipeline": "node scripts/diff.mjs && node scripts/build.mjs"
  },
  "license": "MIT"
}
