{
  "name": "steam-playtime",
  "version": "1.0.0",
  "private": true,
  "description": "每日 Steam 游戏时长追踪，通过 GitHub Actions 定时快照 + 差分，发布到 GitHub Pages",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test tests/unit/diff.test.mjs tests/unit/steam.test.mjs tests/unit/watch-shard.test.mjs tests/unit/watch-country.test.mjs",
    "fetch": "node scripts/pipeline/fetch.mjs",
    "diff": "node scripts/pipeline/diff.mjs",
    "build": "node scripts/pipeline/build.mjs",
    "pipeline": "node scripts/pipeline/diff.mjs && node scripts/pipeline/build.mjs",
    "shard": "node scripts/watch/watch-shard.mjs",
    "shard:check": "node scripts/watch/watch-shard.mjs --check"
  },
  "license": "MIT",
  "dependencies": {
    "sharp": "^0.35.5",
    "undici": "^8.12.3"
  }
}
