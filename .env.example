# 复制此文件为 .env 后填入真实值：cp .env.example .env
# .env 已被 .gitignore 忽略（正则：.env / .env.*，但本文件 !.env.example 例外保留）
# ⚠️ 切勿把填好值的 .env 提交进仓库

# https://steamcommunity.com/dev/apikey 生成的 32 位密钥
STEAM_API_KEY=

# 17 位 SteamID64，可从 https://steamid.io 查询
STEAM_ID64=

# 可选：指定快照日期（YYYY-MM-DD，Asia/Shanghai），用于补录；留空 = 今天
OVERRIDE_DATE=

# 可选：true 时覆盖同日已有快照
FORCE=
